# Infinibay — Docker dev environment config
# Copy to .env.docker (./dev.sh does this automatically on first `up`):
#   cp .env.docker.example .env.docker
# All values have sane defaults; you usually only touch ports or admin creds.

# ─── Source repos ────────────────────────────────────────────────────────────
# Where ./dev.sh clones backend/frontend/infiniservice/infinization and what the
# containers bind-mount. Edit the code there and it reloads live. Point this at
# your existing sibling checkouts (REPOS_DIR=..) to use those instead of clones.
REPOS_DIR=./repos
# Git ref pulled for every repo on `./dev.sh pull` (first clone always uses it).
REPO_REF=main

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=infinibay
POSTGRES_PASSWORD=infinibay
POSTGRES_DB=infinibay
POSTGRES_PORT=5432

# ─── Backend (GraphQL + Socket.io, port 4000) ────────────────────────────────
BACKEND_PORT=4000
NODE_ENV=development
# JWT secret. Dev default is insecure on purpose; change for anything shared.
TOKENKEY=dev-insecure-change-me
BCRYPT_ROUNDS=10
LOG_LEVEL=info
# LAN / REMOTE ACCESS: by default ./dev.sh auto-detects this host's LAN IP and
# advertises it so the UI/API are reachable from other devices (it fills APP_HOST,
# GRAPHIC_HOST, NEXT_PUBLIC_* and ALLOWED_ORIGINS below, keeping localhost working
# too). The CORS allow-list it builds covers, in dev: localhost, 127.0.0.1, the
# LAN IP, an optional public IP, and any extra domains. Knobs:
#   HOST_IP=192.168.0.199   pin the LAN IP (HOST_IP=localhost → localhost-only)
#   PUBLIC_IP=auto          add this host's public IP to CORS (one external call);
#                           or PUBLIC_IP=203.0.113.7 to set it literally
#   EXTRA_ORIGINS=https://app.example.com,http://app.example.com:3000
#                           extra CORS origins taken verbatim (domains/https/ports)
#   ADVERTISE_HOST=app.example.com
#                           host the BROWSER BUNDLE targets (NEXT_PUBLIC_*); defaults
#                           to the LAN IP. Set this (or pin NEXT_PUBLIC_* below) when
#                           you reach the app via a public IP or domain, since the
#                           bundle can only point at ONE host.
#
# Host advertised to VMs (SPICE links / asset fetch). Left at localhost, dev.sh
# substitutes the detected LAN IP; set a value here to pin it.
APP_HOST=localhost
GRAPHIC_HOST=localhost
# Browser origins allowed by the backend CORS (comma-separated, EXACT match, no
# spaces — never '*', because the API uses credentials). dev.sh appends the
# detected LAN IP automatically; add extra origins here if you browse from more
# hosts, e.g. http://192.168.0.199:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Run the DB seed on first boot (creates baseline data / admin if the seed does)
RUN_SEED=true
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=password

# ─── Frontend (Next.js, port 3000) ───────────────────────────────────────────
FRONTEND_PORT=3000
# Baked into the browser bundle, so they must be reachable from whatever device
# loads the UI. Left at localhost, dev.sh rewrites the host to the detected LAN IP
# (so remote devices work); pin a value here to override. If you change
# BACKEND_PORT, change the port here to match.
NEXT_PUBLIC_BACKEND_HOST=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:4000/graphql
