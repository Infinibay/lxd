# Infinibay — Docker dev environment config
# Copy to .env.docker (./dev.sh does this automatically on first `up`):
#   cp .env.docker.example .env.docker
# All values have sane defaults; you usually only touch ports or admin creds.

# ─── Source repos ────────────────────────────────────────────────────────────
# Where ./dev.sh clones backend/frontend/infiniservice/infinization and what the
# containers bind-mount. Edit the code there and it reloads live. Point this at
# your existing sibling checkouts (REPOS_DIR=..) to use those instead of clones.
REPOS_DIR=./repos
# Git ref pulled for every repo on `./dev.sh pull` (first clone always uses it).
REPO_REF=main

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=infinibay
POSTGRES_PASSWORD=infinibay
POSTGRES_DB=infinibay
POSTGRES_PORT=5432

# ─── Backend (GraphQL + Socket.io, port 4000) ────────────────────────────────
BACKEND_PORT=4000
NODE_ENV=development
# JWT secret. Dev default is insecure on purpose; change for anything shared.
TOKENKEY=dev-insecure-change-me
BCRYPT_ROUNDS=10
LOG_LEVEL=info
# Host advertised to VMs (SPICE links / asset fetch). localhost is fine for the
# Mac control-plane-only mode; set to the host LAN IP when running with KVM.
APP_HOST=localhost
GRAPHIC_HOST=localhost
# Run the DB seed on first boot (creates baseline data / admin if the seed does)
RUN_SEED=true
DEFAULT_ADMIN_EMAIL=admin@infinibay.local
DEFAULT_ADMIN_PASSWORD=admin12345

# ─── Frontend (Next.js, port 3000) ───────────────────────────────────────────
FRONTEND_PORT=3000
# These are baked into the browser bundle, so they must be reachable FROM YOUR
# MAC (not the compose DNS name). Keep them pointing at the published backend
# port above. If you change BACKEND_PORT, change these to match.
NEXT_PUBLIC_BACKEND_HOST=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:4000/graphql
