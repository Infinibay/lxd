# LXD Compose Render Values Example
# Copy this file to values.yml and customize for your deployment

# Database Configuration
DB_NAME: "infinibay"
DB_USER: "infinibay"
DB_PASSWORD: "changeme"  # CHANGE THIS!
DB_PORT: "5432"
POSTGRES_MEMORY_LIMIT: "4GB"
POSTGRES_CPU_LIMIT: "2"

# Redis Configuration
REDIS_PORT: "6379"
REDIS_ENABLED: "true"
REDIS_MEMORY_LIMIT: "1GB"
REDIS_CPU_LIMIT: "1"

# Backend Configuration
BACKEND_PORT: "4000"
BACKEND_MEMORY_LIMIT: "4GB"
BACKEND_CPU_LIMIT: "4"

# Frontend Configuration
FRONTEND_PORT: "3000"
FRONTEND_MEMORY_LIMIT: "2GB"
FRONTEND_CPU_LIMIT: "2"

# Network Configuration
HOST_IP: "192.168.0.199"  # Your host's IP address

# Admin Configuration
ADMIN_EMAIL: "admin@example.com"
ADMIN_PASSWORD: "changeme"  # CHANGE THIS!

# Libvirt Configuration
LIBVIRT_NETWORK_NAME: "default"
