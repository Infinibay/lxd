# Infinibay LXD Environment Configuration
# Copy this file to .env and customize for your deployment

# ========================================
# Database Configuration
# ========================================
DB_NAME=infinibay
DB_USER=infinibay
DB_PASSWORD=changeme_secure_password_here
DB_HOST=infinibay-postgres
DB_PORT=5432

# ========================================
# Admin User (Default Credentials)
# ========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin_password

# ========================================
# Application Secrets (auto-generated by setup.sh)
# ========================================
# JWT signing key for the backend API.
TOKENKEY=changeme_token_key
# Master secret for authenticating commands to the in-guest infiniservice agent.
# Each VM's per-VM key is derived as HMAC(this, vmId) and injected at VM
# provisioning. MUST be strong and unique — a predictable value makes the
# agent's command authentication worthless. The deploy REFUSES to provision
# while this holds the placeholder value below.
INFINISERVICE_HMAC_MASTER_SECRET=changeme_hmac_master_secret

# ========================================
# Network Configuration
# ========================================
# Host IP address for VM connectivity
# Auto-detect with: ip route get 1 | awk '{print $7; exit}'
HOST_IP=192.168.1.100

# Libvirt virtual network name
LIBVIRT_NETWORK_NAME=default

# Service ports
BACKEND_PORT=4000
FRONTEND_PORT=3000
REDIS_PORT=6379
POSTGRES_PORT=5432

# ========================================
# Application Configuration
# ========================================
# Application version/tag
INFINIBAY_VERSION=latest

# Base directories (inside containers)
INFINIBAY_BASE_DIR=/opt/infinibay
INFINIBAY_DATA_DIR=/data

# Host data directory (mounted into containers)
HOST_DATA_DIR=/var/lib/infinibay/data

# ========================================
# Feature Flags
# ========================================
# Skip ISO downloads on first setup
SKIP_ISO_DOWNLOAD=false
SKIP_WINDOWS_ISO_DOWNLOAD=false

# Enable Redis caching (recommended)
REDIS_ENABLED=true

# ========================================
# Repository URLs (for private repos)
# ========================================
# Leave empty to use default public repos
# For private repos, use: https://TOKEN@github.com/org/repo.git
REPO_BACKEND=
REPO_FRONTEND=
REPO_LIBVIRT_NODE=
REPO_INFINISERVICE=

# ========================================
# Resource Limits
# ========================================
# CPU cores per container (empty = no limit)
BACKEND_CPU_LIMIT=4
FRONTEND_CPU_LIMIT=2
POSTGRES_CPU_LIMIT=2
REDIS_CPU_LIMIT=1

# Memory limits
BACKEND_MEMORY_LIMIT=4GB
FRONTEND_MEMORY_LIMIT=2GB
POSTGRES_MEMORY_LIMIT=4GB
REDIS_MEMORY_LIMIT=1GB

# ========================================
# Advanced Settings
# ========================================
# Libvirt timeouts (milliseconds)
LIBVIRT_CONNECT_TIMEOUT=30000
LIBVIRT_OPERATION_TIMEOUT=60000
VM_START_TIMEOUT=120000
VM_SHUTDOWN_TIMEOUT=60000

# Node environment
NODE_ENV=production

# Enable verbose logging
DEBUG=false
