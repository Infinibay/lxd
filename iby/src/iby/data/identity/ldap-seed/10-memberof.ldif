# Enable the memberOf overlay so group membership is reflected on user entries
# (needed for the backend's group-DN → role mapping to see who is in a group).
# Applied by `iby engine ldap seed --memberof` (ldapmodify -Y EXTERNAL over ldapi://).
# Best-effort: stock OpenLDAP doesn't populate memberOf without this, and the exact
# database index ({1}mdb) can vary by image — a failure here just leaves group→role
# mapping at USER (Active Directory populates memberOf natively, no overlay needed).

dn: cn=module{0},cn=config
changetype: modify
add: olcModuleLoad
olcModuleLoad: memberof

dn: olcOverlay=memberof,olcDatabase={1}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcMemberOf
olcOverlay: memberof
olcMemberOfRefInt: TRUE
olcMemberOfGroupOC: groupOfNames
olcMemberOfMemberAD: member
olcMemberOfMemberOfAD: memberOf
